# PostgreSQL Connection Strings (Supabase)
# DATABASE_URL: Transaction mode pooler (port 6543) for runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Session mode pooler / direct connection (port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Isolated PostgreSQL Test Database (For Integration Tests Only — NEVER point to production)
# Example local PostgreSQL 18 instance:
# TEST_DATABASE_URL="postgresql://postgres:[LOCAL_PASSWORD]@localhost:5432/creativespace_test"

# NextAuth / Auth.js Configuration
NEXTAUTH_SECRET="your-super-secret-random-key-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Supabase Storage & Client API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Storage Settings
STORAGE_BUCKET_NAME="creativespace-assets"
MAX_UPLOAD_SIZE_MB="50"
